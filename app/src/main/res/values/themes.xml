<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Day/night Material 3 theme; colours in values(-night)/colors.xml. -->
    <style name="Theme.Nimipaivat" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="android:windowBackground">@color/md_surface</item>
    </style>

    <!-- M3 segmented button segment (calendar, pastel finish, preview backdrop). -->
    <style name="Widget.Nimipaivat.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:checkable">true</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">18dp</item>
        <item name="backgroundTint">@color/segmented_button_background</item>
        <item name="android:textColor">@color/segmented_button_text</item>
        <item name="iconTint">@color/segmented_button_text</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- Compact variant for the preview backdrop switch (still a 48dp touch target). -->
    <style name="Widget.Nimipaivat.SegmentedButton.Small">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="iconSize">14dp</item>
        <item name="iconPadding">4dp</item>
    </style>

    <style name="TextAppearance.Nimipaivat.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Nimipaivat.GroupHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
