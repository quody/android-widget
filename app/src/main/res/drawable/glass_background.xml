<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 0: Outer shadow/glow simulation -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10000000" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Layer 1: Main glass pane, inset to reveal shadow edge -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF" />
            <corners android:radius="24dp" />
            <stroke
                android:width="0.5dp"
                android:color="#50FFFFFF" />
        </shape>
    </item>

    <!-- Layer 2: Top highlight — simulates light catching the upper edge -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>

</layer-list>
