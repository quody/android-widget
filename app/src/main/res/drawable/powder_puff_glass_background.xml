<?xml version="1.0" encoding="utf-8"?>
<!-- Powder puff, glass variant: a translucent pastel tint over the wallpaper instead
     of an opaque card. Keep in sync with the glass palette in WidgetStyle.kt (the
     wavy-edge bitmap paints the same layers). Text sits on the inner panel;
     tint + panel together still cover most of the wallpaper for legibility. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 0: Translucent pastel tint -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#99BFDDF0"
                android:endColor="#99D3DDFB"
                android:angle="315" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Layer 1: Decorative soft blob, top-end corner -->
    <item
        android:width="72dp"
        android:height="52dp"
        android:gravity="top|end"
        android:top="4dp"
        android:right="4dp">
        <shape android:shape="oval">
            <solid android:color="#66A9C8F5" />
        </shape>
    </item>

    <!-- Layer 2: Decorative soft blob, bottom-start corner -->
    <item
        android:width="60dp"
        android:height="44dp"
        android:gravity="bottom|start"
        android:bottom="4dp"
        android:left="4dp">
        <shape android:shape="oval">
            <solid android:color="#66C4CCF7" />
        </shape>
    </item>

    <!-- Layer 3: Frosted inner panel (all text sits on this) -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#73FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Layer 4: Top highlight, light catching the upper edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Layer 5: Translucent accent border; outer edge on the 24dp radius -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="3dp"
                android:color="#B38AA4E8" />
            <corners android:radius="22.5dp" />
        </shape>
    </item>

    <!-- Layer 6: Thin light rim just inside the border (glass edge sheen) -->
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF" />
            <corners android:radius="20.5dp" />
        </shape>
    </item>

</layer-list>
